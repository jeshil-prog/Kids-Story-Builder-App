# Copy this to .env.local for local dev
# Add these same keys in Vercel dashboard → Settings → Environment Variables

# --- Server-side (used in /api routes, never exposed to the browser) ---

# console.anthropic.com — used for character photo analysis (Claude Vision)
ANTHROPIC_API_KEY=sk-ant-...

# platform.openai.com — story text, images, TTS narration
OPENAI_API_KEY=sk-...
# platform.openai.com → Settings → Webhooks → the signing secret shown
# when you register the /api/webhook-openai-image endpoint
OPENAI_WEBHOOK_SECRET=whsec_...

# elevenlabs.io — sound effects generation
ELEVENLABS_API_KEY=...

# AWS S3 — character photos and scene images
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=storydream-assets

# Upstash Redis — image generation job status
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# --- Client-side (VITE_ prefix required — these ARE exposed to the browser) ---

# platform.openai.com — used directly from the browser for narration TTS playback
VITE_OPENAI_API_KEY=sk-...

# supabase.com → your project → Settings → API Keys
# The publishable key is safe to expose in client code — it's meaningless
# without Row Level Security policies, which is what actually protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
